const adminMiddleware = account.createAuthMiddleware(async (ctx) => {
  const session = await account.getSessionFromCtx(ctx);
  if (!session?.session) {
    throw new betterCall.APIError("UNAUTHORIZED");
  }
  return {
    session
  };
});

exports.adminMiddleware = adminMiddleware;
